# ===== Документы =====
# Папка с исходниками (прайсы, презентации, записи обучения и т.д.)
DOCS_DIR=/opt/db

# ===== Модели =====
# Выбор модели генерации по памяти — см. docs/MODELS.md:
#   8–16 ГБ: qwen3:8b, gemma3:12b ; 24 ГБ: qwen2.5:32b, qwen3.6:35b-a3b ; 48–96 ГБ: qwen2.5:72b
LLM_MODEL=qwen3.6:35b-a3b-q4_K_M
OLLAMA_URL=http://localhost:11434
# Размышления гибридных моделей (Qwen3/3.6, DeepSeek-R1). false = отвечать сразу,
# без длинной фазы «thinking» (рекомендуется для RAG; иначе ответ долго «молчит»).
LLM_THINK=false
EMBED_MODEL=BAAI/bge-m3            # эмбеддер: BAAI/bge-m3 (1024d) — см. docs/MODELS.md
RERANK_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=mps                       # mps (Apple), cuda или cpu

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_kb

# ===== Параметры RAG =====
CHUNK_SIZE=900                   # размер чанка в символах
CHUNK_OVERLAP=150
TOP_K_RETRIEVE=20                # сколько достаём из БД
TOP_K_RERANK=6                   # сколько оставляем после реранка
MIN_SCORE=0.30                   # порог релевантности (0..1) — ниже = "не знаю"

# ===== Транскрибация =====
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# ===== Redis (кэш агрегатов + семантический кэш + общий учёт vision) =====
# Включён по умолчанию; установщик ставит и запускает redis-server. Если Redis нет —
# приложение продолжает работать (кэш в памяти / общий учёт через rag_logs.db).
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=                # заполните, если включили requirepass

# ===== Клонирование голоса (XTTS) =====
# Адрес отдельного микросервиса XTTS (свой venv с coqui-tts). Ставится скриптом установки
# при INSTALL_XTTS=1 (по умолчанию) и прописывается автоматически. Пусто = синтез голоса-клона
# выключен (используются espeak/say/piper). Подробно — docs/USAGE.md.
XTTS_URL=

# ===== Надёжность: алерты о сбоях =====
ALERTS_ENABLED=false             # слать уведомления о падении компонентов/задач
ALERT_TG_CHAT=                   # chat_id для алертов в Телеграм (токен — из TELEGRAM_BOT_TOKEN)
ALERT_EMAIL=                     # получатель(и) e-mail через запятую
ALERT_COOLDOWN=900               # пауза между повторами по одной проблеме, с
ALERT_ON_JOB_FAIL=true           # алерт при падении фоновых задач
SMTP_HOST=                       # SMTP-сервер для e-mail-алертов (пусто = почта выключена)
SMTP_PORT=587                    # 587 (STARTTLS) или 465 (SSL)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                       # адрес отправителя (пусто = SMTP_USER)
SMTP_TLS=starttls                # starttls | ssl | none

# ===== Доступ =====
API_HOST=0.0.0.0
API_PORT=8000
# Пароль админ-панели. Пусто = без пароля (только для доверенной локальной сети!)
ADMIN_TOKEN=
