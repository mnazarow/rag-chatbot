# ===== Документы =====
DOCS_DIR=/opt/db

# ===== Генерация: vLLM (OpenAI-совместимый сервер) =====
LLM_BACKEND=openai
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=EMPTY
# Модель = тот же id, что отдаёт vLLM (см. VLLM_MODEL в docker-compose.gpu.yml).
# setup_gpu.sh предлагает выбор в меню (Qwen3.6/GLM-5.2) и подставляет сюда автоматически.
LLM_MODEL=QuantTrio/Qwen3.6-35B-A3B-AWQ
# Версия образа vLLM (≥0.19 нужна для Qwen3.6/GLM-5.2). Меняйте при необходимости.
VLLM_IMAGE=vllm/vllm-openai:v0.19.0

# ===== Эмбеддинги / реранк на GPU =====
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
DEVICE=cuda

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=company_kb

# ===== Параметры RAG =====
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_RETRIEVE=20
TOP_K_RERANK=6
MIN_SCORE=0.30

# ===== Транскрибация =====
WHISPER_BACKEND=faster
WHISPER_MODEL=large-v3

# ===== Клонирование голоса (XTTS) =====
# Адрес отдельного микросервиса XTTS (свой venv .venv-xtts + systemd rag-xtts). Прописывается
# скриптом установки автоматически при INSTALL_XTTS=1. Пусто = голос-клон выключен.
XTTS_URL=

# ===== Доступ =====
API_HOST=0.0.0.0
API_PORT=8000
# Пароль админ-панели. Пусто = без пароля (только для доверенной локальной сети!)
ADMIN_TOKEN=
